FROM python:3.11-windowsservercore-ltsc2022

WORKDIR C:/app

# Install Microsoft Visual C++ Runtime
COPY vc_redist.x64.exe C:/vc_redist.x64.exe
RUN C:/vc_redist.x64.exe /install /quiet /norestart

# Install Microsoft ODBC Driver 17 for SQL Server
COPY msodbcsql17.msi C:/msodbcsql17.msi
RUN cmd /c "msiexec.exe /i C:\msodbcsql17.msi /qn /norestart IACCEPTMSODBCSQLLICENSETERMS=YES"

# Verify ODBC Driver 17
RUN powershell -Command "Get-OdbcDriver | Where-Object { $_.Name -eq 'ODBC Driver 17 for SQL Server' } | Format-Table -AutoSize"

# Copy requirements
COPY cri/requirements.txt C:/app/requirements.txt

# Install Python dependencies
RUN python -m pip install --upgrade pip
RUN pip install --no-cache-dir -r C:/app/requirements.txt

# Copy only CRI runtime files
COPY cri/config/ C:/app/config/
COPY cri/core/ C:/app/core/
COPY cri/data/ C:/app/data/
COPY cri/embeddings/ C:/app/embeddings/
COPY cri/frontend/ C:/app/frontend/
COPY cri/scripts/ C:/app/scripts/
COPY ["cri/prompt rules/", "C:/app/prompt rules/"]

# Copy required root-level files
COPY ["cri/def functions.py", "C:/app/def functions.py"]
COPY cri/Modelfile C:/app/Modelfile

EXPOSE 5000

CMD ["python", "-m", "uvicorn", "core.chatbot_backend:app", "--host", "0.0.0.0", "--port", "5000"]